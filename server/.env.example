PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cems?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Google sign-in (OAuth Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
# Password-reset emails through Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=College Event Management <onboarding@resend.dev>
# Cloudinary image hosting (all three are needed; otherwise images are saved in server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
